    {
      "itemIdentifier": "geonovum.dtaas.prov-o.opentelemetry-mapping",
      "name": "OpenTelemetry to PROV-O mapping",
      "abstract": "Experimental RML mapping from an OTLP trace to PROV-O activities, agents, entities, usages, and associations.",
      "status": "under-development",
      "itemClass": "schema",
      "register": "ogc-building-block-examples",
      "dateTimeAddition": "2026-08-26T00:00:00Z",
      "version": "0.1",
      "maturity": "development",
      "tags": [
        "opentelemetry",
        "prov-o",
        "rml",
        "provenance"
      ],
      "dependsOn": [
        "bblocks://geonovum.dtaas.opentelemetry.trace"
      ],
      "description": "The transform converts OTLP resourceSpans into an IPT-qualified result. Span and trace records become PROV activities; dpl.objects.data_object_def values become PROV entities; and dpl.core.processing_activity_id and dpl.core.data_subject_id values become PROV agents.",
      "resources": [
        {
          "title": "Reference RML mapping",
          "role": "mapping",
          "ref": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping/examples/otel-prov.rml.ttl",
          "format": "text/turtle"
        }
      ],
      "shaclShapes": null,
      "dateOfLastChange": "2026-08-26",
      "schema": [
        {
          "prof:hasArtifact": "https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping/schema.yaml",
          "prof:hasRole": "role:schema",
          "dct:format": "application/yaml",
          "dct:conformsTo": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "prof:hasArtifact": "https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping/schema.json",
          "prof:hasRole": "role:schema",
          "dct:format": "application/json",
          "dct:conformsTo": "https://json-schema.org/draft/2020-12/schema"
        }
      ],
      "sourceSchema": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping/schema.yaml",
      "resolvedSchemaProperties": "https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping/resolvedProperties.json",
      "sourceFiles": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping/",
      "validationPassed": true,
      "testOutputs": "https://github.com/Geonovum-labs/ospd-dtaas-register/blob/main/build/tests/dtaas/prov-o/opentelemetry-mapping/",
      "transforms": [
        {
          "id": "otlp-to-prov-o",
          "description": "Convert an OpenTelemetry OTLP JSON trace into an IPT-qualified PROV activity result.",
          "type": "python",
          "inputs": {
            "mediaTypes": [
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ]
          },
          "outputs": {
            "mediaTypes": [
              {
                "mimeType": "application/ld+json",
                "label": "JSON-LD",
                "defaultExtension": "jsonld"
              }
            ],
            "profiles": [
              "bblocks://ogc.osc.api-profiles.processes.ipt.results"
            ]
          },
          "code": "import json\nfrom datetime import datetime, timezone\nfrom urllib.parse import quote\n\ndata = json.loads(input_data)\nbase = \"https://example.org/provenance/\"\ndef iri(value):\n    return base + quote(str(value), safe=\"/:?#[]@!$&'()*+,;=%\")\n\ndef timestamp(value):\n    seconds, nanos = divmod(int(value), 1_000_000_000)\n    instant = datetime.fromtimestamp(seconds, timezone.utc)\n    return instant.strftime(\"%Y-%m-%dT%H:%M:%S\") + f\".{nanos:09d}Z\"\n\ndef attr_map(attributes):\n    result = {}\n    for attribute in attributes or []:\n        value = attribute.get(\"value\", {})\n        result[attribute.get(\"key\")] = next(iter(value.values()), None)\n    return result\n\nresult = None\nfor resource_span in data.get(\"resourceSpans\", []):\n    for scope_span in resource_span.get(\"scopeSpans\", []):\n        for span in scope_span.get(\"spans\", []):\n            trace_id = span.get(\"traceId\")\n            span_id = span.get(\"spanId\")\n            trace_ref = iri(\"trace/\" + trace_id)\n            span_ref = iri(\"span/\" + span_id)\n            attributes = attr_map(span.get(\"attributes\"))\n            activity = {\n                \"id\": span_ref,\n                \"provType\": \"Activity\",\n                \"startedAtTime\": timestamp(span[\"startTimeUnixNano\"]),\n                \"endedAtTime\": timestamp(span[\"endTimeUnixNano\"]),\n                \"wasGeneratedBy\": trace_ref\n            }\n            object_definition = attributes.get(\"dpl.objects.data_object_def\")\n            if object_definition:\n                entity_ref = iri(\"entity/\" + object_definition)\n                activity[\"used\"] = {\"id\": entity_ref, \"provType\": \"Entity\", \"value\": object_definition}\n            for key, role in ((\"dpl.core.processing_activity_id\", \"processing-activity\"), (\"dpl.core.data_subject_id\", \"data-subject\")):\n                agent_value = attributes.get(key)\n                if agent_value:\n                    agent_ref = iri(\"agent/\" + role + \"/\" + agent_value)\n                    activity.setdefault(\"wasAssociatedWith\", []).append({\"id\": agent_ref, \"provType\": \"Agent\", \"value\": agent_value})\n            result = {\"encoding\": \"json\", \"mediaType\": \"application/ld+json\", \"value\": activity}\n\nif result is None:\n    raise ValueError(\"The OTLP trace contains no spans\")\noutput_data = json.dumps(result, indent=2)"
        }
      ],
      "documentation": {
        "markdown": {
          "mediatype": "text/markdown",
          "url": "https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/markdown/dtaas/prov-o/opentelemetry-mapping/index.md"
