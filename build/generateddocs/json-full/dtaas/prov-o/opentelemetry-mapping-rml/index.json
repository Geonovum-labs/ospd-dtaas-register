  "schema": {
    "application/yaml": "https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping-rml/schema.yaml",
    "application/json": "https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping-rml/schema.json"
  },
  "sourceSchema": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping-rml/schema.yaml",
  "resolvedSchemaProperties": "https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping-rml/resolvedProperties.json",
  "sourceFiles": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping-rml/",
  "validationPassed": true,
  "testOutputs": "https://github.com/Geonovum-labs/ospd-dtaas-register/blob/main/build/tests/dtaas/prov-o/opentelemetry-mapping-rml/",
  "transforms": [
    {
      "id": "otlp-to-prov-o-rml",
      "description": "Convert an OpenTelemetry OTLP JSON trace into PROV-O RDF using the RML transform plugin.",
      "type": "rml",
      "inputs": {
        "mediaTypes": [
          {
            "mimeType": "application/json",
            "label": "JSON",
            "defaultExtension": "json"
          }
        ]
      },
      "outputs": {
        "mediaTypes": [
          {
            "mimeType": "text/turtle",
            "label": "RDF/Turtle",
            "defaultExtension": "ttl"
          }
        ],
        "profiles": [
          "bblocks://geonovum.dtaas.prov-o.otel-ipt"
        ]
      },
      "ref": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping-rml/examples/otel-prov.rml.ttl",
      "code": "@prefix rr: <http://www.w3.org/ns/r2rml#> .\n@prefix rml: <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql: <http://semweb.mmlab.be/ns/ql#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix prov: <http://www.w3.org/ns/prov#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix ex: <https://example.org/terms/> .\n@base <http://example.com/ns#> .\n\n<#ResultMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[0]\"\n  ] ;\n  rr:subjectMap [\n    rr:constant \"http://example.org/result/localoutlier_simple\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate dcterms:description ;\n    rr:objectMap [ rr:constant \"Example IPT provenance output for a Local Outlier Factor process after the OTLP-to-PROV mapping.\" ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate ex:process ;\n    rr:objectMap [ rr:parentTriplesMap <#ProcessMap> ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate ex:provenance ;\n    rr:objectMap [ rr:parentTriplesMap <#ProvenanceMap> ]\n  ] .\n\n<#ProcessMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[0]\"\n  ] ;\n  rr:subjectMap [\n    rr:constant \"localoutlier_simple\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate rdf:type ;\n    rr:objectMap [ rr:constant \"https://example.org/processes/localoutlier_simple\" ]\n  ] .\n\n<#ProvenanceMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[0]\"\n  ] ;\n  rr:subjectMap [\n    rr:constant \"http://example.org/provenance/localoutlier_simple\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate prov:activity ;\n    rr:objectMap [ rr:parentTriplesMap <#ActivityMap> ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate prov:used ;\n    rr:objectMap [ rr:parentTriplesMap <#DataProductMap> ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate prov:used ;\n    rr:objectMap [ rr:parentTriplesMap <#InputValueMap> ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate prov:wasAssociatedWith ;\n    rr:objectMap [ rr:parentTriplesMap <#AgentMap> ]\n  ] .\n\n<#ActivityMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[0]\"\n  ] ;\n  rr:subjectMap [\n    rr:template \"{attributes[0].value.stringValue}\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate rdf:type ;\n    rr:objectMap [ rr:constant \"http://www.w3.org/ns/prov#Activity\" ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate rdfs:label ;\n    rr:objectMap [ rr:template \"{name}\" ]\n  ] .\n\n<#DataProductMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[0]\"\n  ] ;\n  rr:subjectMap [\n    rr:template \"{attributes[1].value.stringValue}\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate rdf:type ;\n    rr:objectMap [ rr:constant \"http://www.w3.org/ns/prov#Entity\" ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate prov:role ;\n    rr:objectMap [ rr:constant \"dataObject\" ]\n  ] .\n\n<#InputValueMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[0].attributes[2].value.arrayValue.values[*]\"\n  ] ;\n  rr:subjectMap [\n    rr:template \"http://example.org/used/{intValue}\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate rdf:type ;\n    rr:objectMap [ rr:constant \"http://www.w3.org/ns/prov#Entity\" ]\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate prov:role ;\n    rr:objectMap [ rr:constant \"input\" ]\n  ] .\n\n<#AgentMap> a rr:TriplesMap ;\n  rml:logicalSource [\n    rml:source \"../../../opentelemetry/trace/examples/localoutlier-trace.json\" ;\n    rml:referenceFormulation ql:JSONPath ;\n    rml:iterator \"$.resourceSpans[*]\"\n  ] ;\n  rr:subjectMap [\n    rr:template \"{resource.attributes[0].value.stringValue}\"\n  ] ;\n  rr:predicateObjectMap [\n    rr:predicate rdf:type ;\n    rr:objectMap [ rr:constant \"http://www.w3.org/ns/prov#SoftwareAgent\" ]\n  ] .\n"
    }
  ],
