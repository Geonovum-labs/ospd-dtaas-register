  "testOutputs": "https://github.com/Geonovum-labs/ospd-dtaas-register/blob/main/build/tests/dtaas/ogcapi/processes/ldv/opentelemetry-mapping-rml/",
  "transforms": [
    {
      "id": "otlp-to-prov-o-rml",
      "description": "Convert an OpenTelemetry OTLP JSON trace into PROV-O RDF using the RML transform plugin.",
      "type": "rml",
      "inputs": {
        "mediaTypes": [
          {
            "mimeType": "application/json",
            "label": "JSON",
            "defaultExtension": "json"
          }
        ]
      },
      "outputs": {
        "mediaTypes": [
          {
            "mimeType": "text/turtle",
            "label": "RDF/Turtle",
            "defaultExtension": "ttl"
          }
        ]
      },
      "ref": "https://geonovum-labs.github.io/ospd-dtaas-register/_sources/ogcapi/processes/ldv/opentelemetry-mapping-rml/examples/otel-prov-stml.rml.ttl",
      "code": "@prefix rr:      <http://www.w3.org/ns/r2rml#> .\n@prefix rml:     <http://semweb.mmlab.be/ns/rml#> .\n@prefix ql:      <http://semweb.mmlab.be/ns/ql#> .\n@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .\n@prefix prov:    <http://www.w3.org/ns/prov#> .\n@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix acttype: <https://w3id.org/ogc/rim/activity-type/> .\n\n@base <http://trace.example.com/mapping/> .\n\n\n#################################################################\n# 1. ACTIVITY MAPPING\n#################################################################\n\n<#ActivityMapping>\n    a rr:TriplesMap ;\n\n    rml:logicalSource [\n        rml:source \"../../localoutlier-ipt/examples/localoutlier-trace.json\" ;\n        rml:referenceFormulation ql:JSONPath ;\n        rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[*]\"\n    ] ;\n\n    rr:subjectMap [\n        rr:template \"http://trace.example.com/activity/{spanId}\" ;\n        rr:class prov:Activity ;\n        rr:termType rr:IRI\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate rdf:type ;\n        rr:object prov:Activity\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate rdfs:label ;\n        rr:objectMap [\n            rml:reference \"name\" ;\n            rr:datatype xsd:string\n        ]\n    ] ;\n\n    # PROV relaties gekoppeld via joinConditions op spanId\n    rr:predicateObjectMap [\n        rr:predicate prov:wasAssociatedWith ;\n        rr:objectMap [\n            rr:parentTriplesMap <#AssociatedAgentMapping> ;\n            rr:joinCondition [\n                rr:child \"spanId\" ;\n                rr:parent \"spanId\"\n            ]\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate prov:used ;\n        rr:objectMap [\n            rr:parentTriplesMap <#UsedEntityDatasetMapping> ;\n            rr:joinCondition [\n                rr:child \"spanId\" ;\n                rr:parent \"spanId\"\n            ]\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate prov:generated ;\n        rr:objectMap [\n            rr:parentTriplesMap <#GeneratedEntityDataProductMapping> ;\n            rr:joinCondition [\n                rr:child \"spanId\" ;\n                rr:parent \"spanId\"\n            ]\n        ]\n    ] ;\n\n    # Schema properties gekoppeld via dezelfde parent mappings\n    rr:predicateObjectMap [\n        rr:predicate acttype:associatedAgentType ;\n        rr:objectMap [\n            rr:parentTriplesMap <#AssociatedAgentMapping> ;\n            rr:joinCondition [\n                rr:child \"spanId\" ;\n                rr:parent \"spanId\"\n            ]\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate acttype:usedEntityType ;\n        rr:objectMap [\n            rr:parentTriplesMap <#UsedEntityDatasetMapping> ;\n            rr:joinCondition [\n                rr:child \"spanId\" ;\n                rr:parent \"spanId\"\n            ]\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate acttype:generatedEntityType ;\n        rr:objectMap [\n            rr:parentTriplesMap <#GeneratedEntityDataProductMapping> ;\n            rr:joinCondition [\n                rr:child \"spanId\" ;\n                rr:parent \"spanId\"\n            ]\n        ]\n    ] .\n\n\n#################################################################\n# 2. ASSOCIATED AGENT (processing_activity_id)\n# Itereren over alle attributes; pyrml pakt de juiste record dankzij de pad-structuur\n#################################################################\n\n<#AssociatedAgentMapping>\n    a rr:TriplesMap ;\n\n    rml:logicalSource [\n        rml:source \"../../localoutlier-ipt/examples/localoutlier-trace.json\" ;\n        rml:referenceFormulation ql:JSONPath ;\n        rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[*]\"\n    ] ;\n\n    rr:subjectMap [\n        rr:template \"http://trace.example.com/agent/{attributes.2.value.stringValue}\" ;\n        rr:class prov:Agent ;\n        rr:termType rr:IRI\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate rdfs:label ;\n        rr:objectMap [\n            rml:reference \"attributes.2.value.stringValue\" ;\n            rr:datatype xsd:string\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate dcterms:source ;\n        rr:objectMap [\n            rml:reference \"attributes.2.value.stringValue\" ;\n            rr:termType rr:IRI\n        ]\n    ] .\n\n\n#################################################################\n# 3. USED ENTITY (dataset_id)\n#################################################################\n\n<#UsedEntityDatasetMapping>\n    a rr:TriplesMap ;\n\n    rml:logicalSource [\n        rml:source \"../../localoutlier-ipt/examples/localoutlier-trace.json\" ;\n        rml:referenceFormulation ql:JSONPath ;\n        rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[*]\"\n    ] ;\n\n    rr:subjectMap [\n        rr:template \"http://trace.example.com/entity/dataset/{attributes.0.value.stringValue}\" ;\n        rr:class prov:Entity ;\n        rr:termType rr:IRI\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate rdfs:label ;\n        rr:objectMap [\n            rr:constant \"Dataset\" ;\n            rr:datatype xsd:string\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate dcterms:source ;\n        rr:objectMap [\n            rml:reference \"attributes.0.value.stringValue\" ;\n            rr:termType rr:IRI\n        ]\n    ] .\n\n\n#################################################################\n# 4. GENERATED ENTITY (dataproduct_id)\n#################################################################\n\n<#GeneratedEntityDataProductMapping>\n    a rr:TriplesMap ;\n\n    rml:logicalSource [\n        rml:source \"../../localoutlier-ipt/examples/localoutlier-trace.json\" ;\n        rml:referenceFormulation ql:JSONPath ;\n        rml:iterator \"$.resourceSpans[*].scopeSpans[*].spans[*]\"\n    ] ;\n\n    rr:subjectMap [\n        rr:template \"http://trace.example.com/entity/data-product/{attributes.1.value.stringValue}\" ;\n        rr:class prov:Entity ;\n        rr:termType rr:IRI\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate rdfs:label ;\n        rr:objectMap [\n            rr:constant \"Data Product\" ;\n            rr:datatype xsd:string\n        ]\n    ] ;\n\n    rr:predicateObjectMap [\n        rr:predicate dcterms:source ;\n        rr:objectMap [\n            rml:reference \"attributes.1.value.stringValue\" ;\n            rr:termType rr:IRI\n        ]\n    ] ."
    }
  ],
