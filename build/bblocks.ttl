<bblocks://geonovum.dtaas.prov-o.opentelemetry-mapping-rml> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "OpenTelemetry to PROV-O mapping (RML plugin)" ;
    dct:abstract "OpenTelemetry OTLP JSON transformed to PROV-O RDF using an RML transform plugin."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-28T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/bblock/geonovum.dtaas.prov-o.opentelemetry-mapping-rml> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/markdown/dtaas/prov-o/opentelemetry-mapping-rml/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/json-full/dtaas/prov-o/opentelemetry-mapping-rml/index.json> ],
        "The transform uses the RML transformer plugin to convert OTLP resourceSpans into PROV-O RDF. Span and trace records become PROV activities and array-valued data object identifiers become qualified usage references."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-08-28"^^xsd:date ;
    skos:inScheme <https://geonovum-labs.github.io/ospd-dtaas-register/> ;
    skos:prefLabel "OpenTelemetry to PROV-O mapping (RML plugin)" ;
    skos:topConceptOf <https://geonovum-labs.github.io/ospd-dtaas-register/> ;
    dcat:keyword "opentelemetry",
        "prov-o",
        "provenance",
        "rml" ;
    prof:hasResource [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping-rml/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:format "text/turtle" ;
            prof:hasArtifact <https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/opentelemetry-mapping-rml/examples/otel-prov.rml.ttl> ;
            prof:hasRole <https://geonovum-labs.github.io/mapping> ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://geonovum-labs.github.io/ospd-dtaas-register/build/annotated/dtaas/prov-o/opentelemetry-mapping-rml/schema.json> ;
            prof:hasRole role:schema ] ;
    bblocks:dependsOn <bblocks://geonovum.dtaas.ogcapi.processes.custom-api-ipt>,
        <bblocks://geonovum.dtaas.opentelemetry.trace> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

