<bblocks://geonovum.dtaas.ogcapi.processes.ldv.localoutlier> a skos:Concept,
        dcat:Dataset,
        bblocks:Api,
        bblocks:BBlock ;
    rdfs:label "Demo OGC API processes instance - LOF" ;
    dct:abstract "An example of an OGC API Processes implementation using building blocks - Local Outlier Factor"^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-12-17T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/json-full/dtaas/ogcapi/processes/ldv/localoutlier/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/markdown/dtaas/ogcapi/processes/ldv/localoutlier/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/bblock/geonovum.dtaas.ogcapi.processes.ldv.localoutlier> ],
        "This OGC API Process served as an example implementation in the LDV (Logboek Dataverwerkingen voor (geo) objecten) project. It uses a Local Outlier Factor Machine Learning Algorithm for classification of observations/measurements. The Process itself does not expose provenance information directly in the API, but in the implementation OpenTelemetry is used server side to create a trace with provenance information using the OpenTelemetry Trace/Span semantics and adhering to the Dutch LDV standard."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "1.0" ;
    dct:license [ rdfs:seeAlso <https://geonovum-labs.github.io/ospd-dtaas-register/LICENSE> ] ;
    dct:modified "2026-10-30"^^xsd:date ;
    dct:source <https://docs.geostandaarden.nl/ldv/logboek-dataverwerkingen-voor-objecten/>,
        <https://logius-standaarden.github.io/logboek-dataverwerkingen/> ;
    skos:inScheme <https://geonovum-labs.github.io/ospd-dtaas-register/> ;
    skos:prefLabel "Demo OGC API processes instance - LOF" ;
    skos:topConceptOf <https://geonovum-labs.github.io/ospd-dtaas-register/> ;
    dcat:keyword "examples",
        "ogc api",
        "ogc api processes" ;
    prof:isProfileOf <bblocks://ogc.api.processes.v1.api> ;
    bblocks:dependsOn <bblocks://geonovum.dtaas.ogcapi.processes.ldv.schemas.inputDescriptions>,
