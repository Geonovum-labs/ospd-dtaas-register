<bblocks://geonovum.dtaas.prov-o.ldv-rml-mapper> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "LDV RML Mapper" ;
    dct:abstract "OpenTelemetry OTLP JSON transformed to PROV-O RDF using an RML transform plugin."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-28T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/json-full/dtaas/prov-o/ldv-rml-mapper/index.json> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/bblock/geonovum.dtaas.prov-o.ldv-rml-mapper> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://geonovum-labs.github.io/ospd-dtaas-register/build/generateddocs/markdown/dtaas/prov-o/ldv-rml-mapper/index.md> ],
        "The transform uses the RML transformer plugin to convert OTLP resourceSpans into PROV-O RDF. Span and trace records become PROV activities and array-valued data object identifiers become qualified usage references. This is the transform done in scope of the Logboek Dataverwerkingen voor Objectgegevens research project"^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1" ;
    dct:license [ rdfs:seeAlso <https://geonovum-labs.github.io/ospd-dtaas-register/LICENSE> ] ;
    dct:modified "2026-10-30"^^xsd:date ;
    dct:source <https://docs.geostandaarden.nl/ldv/logboek-dataverwerkingen-voor-objecten/>,
        <https://logius-standaarden.github.io/logboek-dataverwerkingen/> ;
    skos:inScheme <https://geonovum-labs.github.io/ospd-dtaas-register/> ;
    skos:prefLabel "LDV RML Mapper" ;
    skos:topConceptOf <https://geonovum-labs.github.io/ospd-dtaas-register/> ;
    dcat:keyword "ldv",
        "prov-o",
        "rml" ;
    prof:hasResource [ dct:format "text/turtle" ;
            prof:hasArtifact <https://geonovum-labs.github.io/ospd-dtaas-register/_sources/prov-o/ldv-rml-mapper/examples/ldv-prov.rml.ttl> ;
            prof:hasRole <https://geonovum-labs.github.io/mapping> ] ;
    bblocks:dependsOn <bblocks://geonovum.dtaas.opentelemetry.trace> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

