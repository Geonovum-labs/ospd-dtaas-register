@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#SpanMapping> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "trace.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/provenance/span/{spanId}" ;
    rr:class prov:Activity
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:wasGeneratedBy ;
    rr:objectMap [ rr:template "https://example.org/provenance/trace/{traceId}" ]
  ] .

<#ProcessingActivityMapping> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "trace.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*].attributes[?(@.key=='dpl.core.processing_activity_id')]"
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/provenance/agent/{value.stringValue}" ;
    rr:class prov:Agent
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "value.stringValue" ]
  ] .

<#ObjectMapping> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "trace.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*].attributes[?(@.key=='dpl.objects.data_object_def')]"
  ] ;
  rr:subjectMap [
    rr:template "{value.stringValue}" ;
    rr:class prov:Entity
  ] .