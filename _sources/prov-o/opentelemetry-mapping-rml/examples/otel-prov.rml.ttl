@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com/ns#> .

<#TraceMapping> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "../../../opentelemetry/trace/examples/localoutlier-trace.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[0]"
  ] ;
  rr:subjectMap [
    rr:template "http://trace.example.com/trace/{traceId}" ;
    rr:class prov:Activity
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "traceId" ]
  ] .

<#SpanMapping> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "../../../opentelemetry/trace/examples/localoutlier-trace.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ] ;
  rr:subjectMap [
    rr:template "http://trace.example.com/span/{spanId}" ;
    rr:class prov:Activity
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:wasGeneratedBy ;
    rr:objectMap [
      rr:parentTriplesMap <#TraceMapping> ;
      rr:joinCondition [ rr:child "traceId" ; rr:parent "traceId" ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:qualifiedUsage ;
    rr:objectMap [
      rr:parentTriplesMap <#ObjectUsageMapping> ;
      rr:joinCondition [
        rr:child "http://trace.example.com/span/{spanId}" ;
        rr:parent "http://trace.example.com/span/{spanId}"
      ]
    ]
  ] .

<#ObjectUsageMapping> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "../../../opentelemetry/trace/examples/localoutlier-trace.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*].attributes[2].value.arrayValue.values[*]"
  ] ;
  rr:subjectMap [
    rr:template "http://trace.example.com/use/{intValue}" ;
    rr:class prov:Usage
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "intValue" ]
  ] .
